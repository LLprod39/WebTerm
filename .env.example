# =============================================================================
# WebTerm Agent Platform — mini_prod configuration
# Скопируйте в .env и заполните нужные поля.
# TEST_SYNC_MARKER=local-safe-comment
# =============================================================================

# -----------------------------------------------------------------------------
# База данных (PostgreSQL через Docker)
# Если не задано — используется SQLite (только для разработки)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weu_platform
POSTGRES_USER=weu
POSTGRES_PASSWORD=weu_secret_change_me

# -----------------------------------------------------------------------------
# LLM провайдеры — задайте нужный ключ
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# GROK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional Operator public web research (Brave Search API)
# WEB_SEARCH_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com

# -----------------------------------------------------------------------------
# Сервер и безопасность
# -----------------------------------------------------------------------------
# Публичный URL сервера — используется в ссылках для подтверждения обновлений
SITE_URL=http://localhost:9000

# URL внешнего React SPA. Для локальной разработки это Vite (:8080),
# для Render static site — адрес frontend-сервиса.
FRONTEND_APP_URL=http://127.0.0.1:8080

# Production toggles. На Render обычно нужны:
# DJANGO_DEBUG=false
# SITE_URL=https://app.example.com
# FRONTEND_APP_URL=https://app.example.com
# ALLOWED_HOSTS=app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# CROSS_SITE_AUTH=false
# DJANGO_SECRET_KEY=<long-random-secret>
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# Frontend Vite env lives in frontend/.env or frontend/.env.local
# VITE_ENABLE_DEMO_MODE=true

# Если frontend и backend живут на разных origin, можно явно переопределить.
# По умолчанию backend возьмёт FRONTEND_APP_URL как разрешённый frontend origin.
# CORS_ALLOWED_ORIGINS=https://frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://frontend.example.com

# Разрешённые хосты (через запятую)
# ALLOWED_HOSTS=myserver.example.com,localhost

# CSRF origins (через запятую)
# CSRF_TRUSTED_ORIGINS=https://myserver.example.com

# Секретный ключ Django (смените в продакшене!)
# SECRET_KEY=

# -----------------------------------------------------------------------------
# Email (SMTP) — уведомления, отчёты, письма с подтверждением обновлений
# -----------------------------------------------------------------------------
# Вариант 1: Gmail (App Password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
#
# Вариант 2: Яндекс.Почта — пароль приложения: https://yandex.ru/support/yandex-360/customers/mail/ru/mail-clients/others
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465

EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=True

# Логин (для Яндекса — часть до @, например yourlogin) и пароль приложения
EMAIL_HOST_USER=yourlogin
EMAIL_HOST_PASSWORD=your-app-password

# Адрес отправителя (полный email)
DEFAULT_FROM_EMAIL=WEU Platform <yourlogin@yandex.ru>

# Кому отправлять уведомления пайплайнов
PIPELINE_NOTIFY_EMAIL=yourlogin@yandex.ru

# -----------------------------------------------------------------------------
# Telegram Bot — уведомления и подтверждения прямо в мессенджер
#
# Как настроить за 2 минуты:
#   1. Напишите @BotFather в Telegram → /newbot → получите токен
#   2. Запустите бота (напишите ему /start)
#   3. Узнайте свой chat_id: напишите @userinfobot или @getidsbot
#   4. Заполните переменные ниже
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# Monitoring cache (anti-storm for /servers auto health-check)
# -----------------------------------------------------------------------------
MONITORING_HEALTHCHECK_COOLDOWN_SECONDS=60
MONITORING_HEALTHCHECK_LOCK_SECONDS=45
MONITORING_STATUS_STALE_SECONDS=300
MONITORING_FLEET_REFRESH_COOLDOWN_SECONDS=120
MONITORING_LITE_CHECK_TIMEOUT_SECONDS=5
# A recent full metrics sample may override a transient lightweight
# "unreachable" probe for this many seconds in both monitoring APIs.
MONITORING_FULL_FAIL_METRICS_TRUST_SECONDS=300
MONITORING_LIVE_CACHE_SECONDS=300
MONITORING_METRICS_REFRESH_COOLDOWN_SECONDS=90

# -----------------------------------------------------------------------------
# Redis runtime for local/dev production-like runs
# -----------------------------------------------------------------------------
# Для запуска через Docker Compose оставьте localhost: compose публикует Redis на host.
# Внутри контейнеров docker-compose.yml сам переопределит адрес на redis://redis:6379.
CHANNEL_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# Прочее
# -----------------------------------------------------------------------------
# AGENT_ACTIVE_RUNS_PER_USER_LIMIT=5
# AGENT_ACTIVE_RUNS_GLOBAL_LIMIT=25
# PIPELINE_ACTIVE_RUNS_PER_USER_LIMIT=8
# PIPELINE_ACTIVE_RUNS_GLOBAL_LIMIT=40
# MARS_AGENT_RUNTIME=docker
# Uploaded shell materials run only in this dedicated immutable container. Pilot uses isolated Docker bridge egress; host networking is rejected.
# Build docker/material-runner/Dockerfile, inspect its sha256 image ID, then enable.
# AGENT_MATERIAL_RUNNER_ENABLED=false
# AGENT_MATERIAL_RUNNER_IMAGE=sha256:<64 lowercase hex>
# AGENT_MATERIAL_RUNNER_DOCKER_COMMAND=docker
# AGENT_MATERIAL_RUNNER_DOCKER_NETWORK=bridge
# AGENT_MATERIAL_RUNNER_CPUS=0.25
# AGENT_MATERIAL_RUNNER_MEMORY=128m
# AGENT_MATERIAL_RUNNER_PIDS_LIMIT=32
# AGENT_MATERIAL_RUNNER_INPUT_MAX_BYTES=64000
# AGENT_MATERIAL_RUNNER_OUTPUT_MAX_CHARS=50000

# OpenTelemetry is optional locally. To enable OTLP/HTTP traces and metrics,
# set OTEL_SDK_DISABLED=false and point the endpoint at your collector.
WEBTERM_OTEL_REQUIRED=false
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=webterm
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# MARS_AGENT_DOCKER_IMAGE=webterm-mars-agent:latest
# MARS_AGENT_DOCKER_CPUS=2
# MARS_AGENT_DOCKER_MEMORY=2g
# MARS_AGENT_DOCKER_CODEX_HOME_VOLUME=mini-prod-mars-codex-home
# MARS_AGENT_DOCKER_GEMINI_HOME_VOLUME=mini-prod-mars-gemini-home
# MARS_DOCKER_CONTAINER_PATH_PREFIX=/workspace
# MARS_DOCKER_HOST_PATH_PREFIX=/mnt/c/WebTrerm
# MARS_USER_WORKSPACES_ROOT=agent_projects/mars_workspaces
# SSH_TERMINAL_SESSIONS_PER_USER_LIMIT=12
# SSH_TERMINAL_SESSIONS_GLOBAL_LIMIT=120
# SSH_TERMINAL_SESSION_STALE_SECONDS=180
# SSH_TERMINAL_SESSION_HEARTBEAT_SECONDS=30
# SSH_CONNECT_TIMEOUT_SECONDS=10
# SSH_LOGIN_TIMEOUT_SECONDS=20
# SSH_KEEPALIVE_INTERVAL_SECONDS=20
# SSH_KEEPALIVE_COUNT_MAX=3
# SSH_POOL_IDLE_TTL_SECONDS=60
# SSH_POOL_MAX_PER_SERVER=4
# SSH_POOL_MAX_CONNECTIONS=50
# WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# Development defaults to enabled; production defaults to disabled. Keep the
# production value disabled until the trust-stack release gate is completed.
# PLUGIN_MARKETPLACE_RELEASE_MODE=enabled
# PLUGIN_MARKETPLACE_ALLOW_SANDBOXED_CODE_PACKAGES=false
# PLUGIN_MARKETPLACE_BACKEND_SANDBOX_ENABLED=false
# PLUGIN_MARKETPLACE_BACKEND_SANDBOX_PROVIDER=local_subprocess
# PLUGIN_MARKETPLACE_EXTERNAL_BACKEND_SANDBOX_ENDPOINT=https://sandbox.example.com/plugin-marketplace/execute
# PLUGIN_MARKETPLACE_EXTERNAL_BACKEND_SANDBOX_AUTH_TOKEN=
# PLUGIN_MARKETPLACE_BACKEND_SANDBOX_TIMEOUT_SECONDS=10
# PLUGIN_MARKETPLACE_BACKEND_SANDBOX_MAX_OUTPUT_BYTES=262144
# PLUGIN_MARKETPLACE_FRONTEND_SANDBOX_ENABLED=false
# PLUGIN_MARKETPLACE_ALLOW_DYNAMIC_FRONTEND_BUNDLES=false
# PLUGIN_MARKETPLACE_FRONTEND_BUNDLE_DISTRIBUTION_PROVIDER=manifest_url
# PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_FRONTEND_BUNDLE_HOST=false
# PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_ENDPOINT=https://bundles.example.com/plugin-marketplace/readiness
# PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_AUTH_TOKEN=
# PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_TIMEOUT_SECONDS=10
# PLUGIN_MARKETPLACE_FRONTEND_BUNDLE_ALLOWED_HOSTS=cdn.example.com
# PLUGIN_MARKETPLACE_COMPATIBILITY_JOB_ISOLATION_MODE=in_process_no_code
# PLUGIN_MARKETPLACE_COMPATIBILITY_JOB_TIMEOUT_SECONDS=20
# PLUGIN_MARKETPLACE_SANDBOX_DEPENDENCY_ALLOWLIST=python:requests,npm:@scope/package
# PLUGIN_MARKETPLACE_REQUIRED_ATTESTATION_KINDS=security_scan,remote_provenance_replay
# PLUGIN_MARKETPLACE_ATTESTATION_MAX_AGE_DAYS=30
# PLUGIN_MARKETPLACE_ATTESTATION_RETENTION_LIMIT=20
# PLUGIN_MARKETPLACE_SIGNING_PROVIDER=local_hmac
# PLUGIN_MARKETPLACE_SIGNING_KEYS={}
# PLUGIN_MARKETPLACE_DEFAULT_SIGNING_KEY_ID=
# PLUGIN_MARKETPLACE_REQUIRE_CONFIGURED_SIGNING_KEYS=false
# PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_SIGNING_PROVIDER=false
# PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_ENDPOINT=https://kms.example.com/plugin-marketplace/sign
# PLUGIN_MARKETPLACE_EXTERNAL_VERIFY_ENDPOINT=https://kms.example.com/plugin-marketplace/verify
# PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_AUTH_TOKEN=
# PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_TIMEOUT_SECONDS=5
# PLUGIN_MARKETPLACE_SECURITY_SCAN_PROVIDER=local_static
# PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_SECURITY_SCANNER=false
# PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_ENDPOINT=https://scanner.example.com/plugin-marketplace/scan
# PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_AUTH_TOKEN=
# PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_TIMEOUT_SECONDS=20
# PLUGIN_MARKETPLACE_SECURITY_SCAN_BLOCK_SEVERITIES=critical,high
# PLUGIN_MARKETPLACE_SECURITY_SCAN_PASS_STATUSES=clean,ok,pass,passed,success
# PLUGIN_MARKETPLACE_EGRESS_DENIED_HOSTS=metadata.google.internal,169.254.169.254
# PLUGIN_MARKETPLACE_REMOTE_PACKAGE_ALLOWED_HOSTS=packages.example.com
# Exact HTTPS hosts only. Empty disables remote catalog sync (fail-closed).
# PLUGIN_MARKETPLACE_CATALOG_SOURCE_ALLOWED_HOSTS=catalog.example.com

# GitLab hosts allowed for one-time Ansible project imports. Tokens are request-only and are never stored.
# PLAYBOOK_GITLAB_ALLOWED_HOSTS=gitlab.com,gitlab.corp.example.com
# PLAYBOOK_GITLAB_TIMEOUT_SECONDS=15
# PLUGIN_MARKETPLACE_PACKAGE_RETENTION_DIR=
# PLUGIN_MARKETPLACE_RETAINED_PACKAGE_MAX_AGE_DAYS=0
# MCP_STDIO_INITIALIZE_TIMEOUT_SECONDS=20
# MCP_STDIO_REQUEST_TIMEOUT_SECONDS=30
# MCP_STDIO_TOOL_CALL_TIMEOUT_SECONDS=120
# MCP_PROCESS_TERMINATE_TIMEOUT_SECONDS=2
# MCP_HTTP_CONNECT_TIMEOUT_SECONDS=10
# MCP_HTTP_REQUEST_TIMEOUT_SECONDS=30
# MCP_HTTP_TOOL_CALL_TIMEOUT_SECONDS=120
# MCP_HTTP_RETRY_ATTEMPTS=2
# LLM_MAX_RETRY_ATTEMPTS=3
# LLM_PROVIDER_TIMEOUT_SECONDS=90
# LLM_GEMINI_STREAM_TIMEOUT_SECONDS=90
# LLM_GROK_STREAM_TIMEOUT_SECONDS=3600
# LLM_GROK_REASONING_EFFORT=none
# LLM_CLAUDE_STREAM_TIMEOUT_SECONDS=120
# LLM_OPENAI_STREAM_TIMEOUT_SECONDS=90
# LLM_OPENAI_RESPONSES_TIMEOUT_SECONDS=300
# APP_LOG_FILE=logs/webtrerm.log
# APP_LOG_LEVEL=INFO
# APP_LOG_ROTATION=50 MB
# APP_LOG_RETENTION=14 days
# APP_LOG_SYSLOG_ENABLED=false
# APP_LOG_SYSLOG_ADDRESS=localhost:514
# APP_LOG_SYSLOG_PROTOCOL=udp
# APP_LOG_SYSLOG_FACILITY=LOG_USER
# REDIS_PORT=6379
