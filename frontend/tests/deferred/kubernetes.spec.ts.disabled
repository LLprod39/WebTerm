// Deferred with the Kubernetes UI; see README.md in this directory.
import { expect, test, type Page } from "@playwright/test";
import { login, credentials, assertNoOverflow } from "./helpers";

// Contract fixtures only: real Django login, isolated QA origin, no live Kubernetes provider.
const cluster = {
  id: "cluster_101",
  database_id: 101,
  name: "contract-cluster",
  environment: "staging",
  provider: "rancher",
  health: "healthy",
  nodes_ready: 2,
  nodes_total: 2,
  namespaces: 1,
  workloads: 1,
  last_sync_at: "2026-09-02T06:00:00Z",
  sync_status: "fresh",
};
const namespace = {
  id: "namespace_102",
  name: "payments",
  cluster_id: cluster.id,
  cluster_name: cluster.name,
  health: "healthy",
  workloads: 1,
  last_sync_at: cluster.last_sync_at,
};
const workload = {
  id: "workload_103",
  name: "gateway",
  kind: "Deployment",
  namespace: "payments",
  cluster_id: cluster.id,
  cluster_name: cluster.name,
  health: "healthy",
  ready: 2,
  desired: 2,
  last_sync_at: cluster.last_sync_at,
};
const session = {
  id: "11111111-1111-4111-8111-111111111111",
  mode: "write",
  status: "active",
  cluster_id: cluster.id,
  cluster_name: cluster.name,
  namespace: "payments",
  reason: "Contract fixture change",
  approval_ref: "CHG-FIXTURE",
  approved_by: "reviewer",
  expires_at: "2099-01-01T00:00:00Z",
  allowed_verbs: ["get", "list", "yaml", "dry_run_apply", "apply"],
  allowed_kinds: ["Deployment"],
  allowed_namespaces: ["payments"],
  created_by: credentials.admin.username,
  created_at: cluster.last_sync_at,
  post_review_required: false,
  post_review_status: "none",
};
const workflows = ["live_resource_explorer", "dry_run_apply", "apply_yaml"].map(
  (id) => ({
    id,
    mode: "kubernetes_admin_write",
    available: true,
    requestable: true,
    mutates_state: id === "apply_yaml",
    blocked_reason: "",
    requirements: [],
  }),
);
async function fixtures(page: Page) {
  const writes: { path: string; body: Record<string, unknown> }[] = [];
  let proofs = 0;
  await page.route("**/api/kubernetes/**", async (route) => {
    const req = route.request();
    const u = new URL(req.url());
    const path = u.pathname.replace("/api/kubernetes/", "");
    let payload: Record<string, unknown> = { success: true };
    if (req.method() !== "GET") {
      const body = req.postDataJSON() as Record<string, unknown>;
      writes.push({ path, body });
      if (path.endsWith("resources/dry-run-apply/"))
        payload = {
          ...payload,
          dry_run: true,
          action: { id: `proof-${++proofs}`, status: "dry_run" },
          target: {
            kind: "Deployment",
            namespace: "payments",
            name: "gateway",
          },
          diff: { changes: [], change_count: 0, truncated: false },
          ownership: { owner: "unmanaged" },
        };
      else if (path.endsWith("resources/apply/"))
        payload = {
          ...payload,
          action: { id: "applied-1", status: "completed" },
        };
      else
        return route.fulfill({
          status: 400,
          json: {
            success: false,
            error: `Unexpected fixture mutation: ${path}`,
          },
        });
    } else if (path === "clusters/") payload.clusters = [cluster];
    else if (path === `clusters/${cluster.id}/`) payload.cluster = cluster;
    else if (path === `clusters/${cluster.id}/namespaces/`)
      payload = { ...payload, cluster, namespaces: [namespace] };
    else if (path === `clusters/${cluster.id}/namespaces/${namespace.id}/`)
      payload = {
        ...payload,
        cluster,
        namespace,
        workloads: [workload],
        pods: [],
        network_refs: [],
        events: [],
        summary: {},
      };
    else if (path === `workloads/${workload.id}/`)
      payload = {
        ...payload,
        cluster,
        workload,
        pods: [],
        network_refs: [],
        events: [
          {
            id: 1,
            reason: "Scaled",
            message: "Two replicas available",
            type: "Normal",
            created_at: cluster.last_sync_at,
          },
        ],
        summary: {},
      };
    else if (path === "capabilities/")
      payload = {
        ...payload,
        modes: [
          { id: "kubernetes_admin_read", active: true, granted: true },
          { id: "kubernetes_admin_write", active: true, granted: true },
        ],
        workflows,
      };
    else if (path === `admin/sessions/${session.id}/`)
      payload.session = session;
    else if (path === `admin/clusters/${cluster.id}/discovery/`)
      payload.resource_catalog = {
        status: "ready",
        truncated: false,
        items: [
          {
            id: "apps/v1:deployments",
            api_version: "apps/v1",
            kind: "Deployment",
            resource: "deployments",
            namespaced: true,
            cluster_available: true,
            verbs: ["get", "list"],
            ui_group: "workloads",
          },
        ],
      };
    else if (path === `admin/clusters/${cluster.id}/resources/`)
      payload = {
        ...payload,
        items: [
          {
            apiVersion: "apps/v1",
            kind: "Deployment",
            metadata: {
              name: "gateway",
              namespace: "payments",
              uid: "resource-1",
              creationTimestamp: cluster.last_sync_at,
            },
            summary: { ready: true, replicas: { ready: 2, desired: 2 } },
          },
        ],
        item_count: 1,
        continue_token: "",
        truncated: false,
      };
    else if (path === `admin/clusters/${cluster.id}/resources/detail/`)
      payload = {
        ...payload,
        resource: { apiVersion: "apps/v1", kind: "Deployment" },
        summary: {
          resource_version: "512",
          replicas: { ready: 2, desired: 2 },
          conditions: [],
        },
        events: { available: true, events: [] },
      };
    else
      return route.fulfill({
        status: 404,
        json: { success: false, error: `No contract fixture: ${path}` },
      });
    await route.fulfill({ status: 200, json: payload });
  });
  return writes;
}
test.describe("Kubernetes contract fixtures (no live cluster)", () => {
  test.beforeEach(async ({ page }) => {
    await login(page);
  });
  test("cluster → namespace → workload shows real contract fields and events", async ({
    page,
  }) => {
    await fixtures(page);
    await page.goto("/infrastructure/kubernetes");
    await page
      .getByRole("link", { name: "contract-cluster", exact: true })
      .click();
    await page.getByRole("link", { name: "payments", exact: true }).click();
    await page.getByRole("link", { name: "gateway", exact: true }).click();
    await expect(
      page.getByRole("heading", { name: "gateway", exact: true }),
    ).toBeVisible();
    await page.getByRole("tab", { name: "События", exact: true }).click();
    await expect(page.getByText("Two replicas available")).toBeVisible();
    await assertNoOverflow(page);
  });
  test("manifest editing invalidates dry-run proof and requires separate apply confirmation", async ({
    page,
  }) => {
    const writes = await fixtures(page);
    await page.goto(`/infrastructure/kubernetes/explorer/${session.id}`);
    await page.getByRole("button", { name: "Применить YAML…" }).click();
    const yaml = page.getByLabel("Манифест YAML", { exact: true });
    await yaml.fill(
      "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: gateway",
    );
    await page.getByLabel("Причина изменения").fill("CHG-FIXTURE approved");
    await expect(
      page.getByRole("button", { name: "Проверить и продолжить" }),
    ).toBeDisabled();
    await page.getByRole("button", { name: "Проверить на сервере" }).click();
    await expect(
      page.getByRole("button", { name: "Проверить и продолжить" }),
    ).toBeEnabled();
    await yaml.fill(
      "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: gateway\nspec:\n  replicas: 3",
    );
    await expect(
      page.getByRole("button", { name: "Проверить и продолжить" }),
    ).toBeDisabled();
    await page.getByRole("button", { name: "Проверить на сервере" }).click();
    await page.getByRole("button", { name: "Проверить и продолжить" }).click();
    expect(writes.filter((w) => w.path.endsWith("/apply/"))).toHaveLength(0);
    await page.getByRole("button", { name: "Подтвердить выполнение" }).click();
    await expect(
      page.getByRole("link", { name: "Открыть журнал действий" }),
    ).toBeVisible();
    expect(writes.at(-1)?.body).toMatchObject({
      session_id: session.id,
      dry_run_action_id: "proof-2",
      reason: "CHG-FIXTURE approved",
    });
    await assertNoOverflow(page);
  });
  test("requester cannot approve own session; another staff approval requires a reference", async ({
    page,
  }) => {
    await fixtures(page);
    let approved = false;
    const other = {
      ...session,
      id: "22222222-2222-4222-8222-222222222222",
      status: "pending_approval",
      created_by: "other.operator",
    };
    const own = { ...session, status: "pending_approval" };
    const approvals: unknown[] = [];
    await page.route("**/api/kubernetes/admin/sessions/**", async (route) => {
      const url = new URL(route.request().url());
      if (route.request().method() === "POST") {
        const body = route.request().postDataJSON();
        approvals.push(body);
        approved = true;
        return route.fulfill({
          json: { success: true, session: { ...other, status: "active" } },
        });
      }
      return route.fulfill({
        json: {
          success: true,
          sessions:
            url.searchParams.get("all") === "true"
              ? [{ ...other, status: approved ? "active" : "pending_approval" }]
              : [own],
        },
      });
    });
    await page.goto("/infrastructure/kubernetes/sessions");
    await page.getByRole("button", { name: "Подробнее" }).click();
    await expect(
      page.getByText(
        "Ожидается согласование другим администратором. Собственный запрос согласовать нельзя.",
      ),
    ).toBeVisible();
    await expect(
      page.getByRole("button", { name: "Согласовать", exact: true }),
    ).toHaveCount(0);
    await page.keyboard.press("Escape");
    await page.getByLabel("Показывать сессии всех пользователей").check();
    await page.getByRole("button", { name: "Подробнее" }).click();
    await page
      .getByRole("button", { name: "Согласовать", exact: true })
      .click();
    await page
      .getByRole("button", { name: "Подтвердить", exact: true })
      .click();
    expect(approvals).toHaveLength(0);
    await page
      .getByLabel("Номер заявки или ссылка согласования")
      .fill("CHG-APPROVED");
    await page
      .getByRole("button", { name: "Подтвердить", exact: true })
      .click();
    await expect(page.getByText("Активна", { exact: true })).toBeVisible();
    expect(approvals).toEqual([{ approval_ref: "CHG-APPROVED" }]);
  });
  test("change request separates independent approval, execution policy and recorded verification", async ({
    page,
  }) => {
    await fixtures(page);
    let owner = credentials.admin.username;
    let status = "pending_approval";
    const writes: { path: string; body: Record<string, unknown> }[] = [];
    const request = () => ({
      id: "33333333-3333-4333-8333-333333333333",
      action: "k8s.workload.scale",
      status,
      risk_tier: "high",
      cluster: cluster.name,
      target: {
        cluster_id: cluster.id,
        cluster_name: cluster.name,
        namespace: "payments",
        kind: "Deployment",
        name: "gateway",
        replicas: 3,
      },
      preview: {
        summary: "Scale one workload",
        blast_radius: "single_workload",
        expected_verification: ["Pod readiness"],
        rollback_plan: {},
      },
      execution_policy: { native_execution_enabled: false },
      report: { status },
      reason: "CHG-FIXTURE scale review",
      approval_ref: "",
      requested_by: owner,
      created_at: cluster.last_sync_at,
      updated_at: cluster.last_sync_at,
    });
    await page.route("**/api/kubernetes/readiness/", (route) =>
      route.fulfill({
        json: {
          success: true,
          access_policy: { can_execute_approved_action: false },
        },
      }),
    );
    await page.route("**/api/kubernetes/actions/**", async (route) => {
      const path = new URL(route.request().url()).pathname;
      const body =
        route.request().method() === "POST"
          ? route.request().postDataJSON()
          : undefined;
      if (body) {
        writes.push({ path, body });
        if (path.endsWith("/approve-external/")) status = "approved_external";
        else if (path.endsWith("/verify-external/"))
          status = "verified_external";
        else
          return route.fulfill({
            status: 403,
            json: { success: false, error: "Policy denied" },
          });
      }
      return route.fulfill({
        json: path.endsWith("/report/")
          ? { success: true, request: request(), timeline: [] }
          : { success: true, request: request() },
      });
    });
    const url = `/infrastructure/kubernetes/requests/${request().id}`;
    await page.goto(url);
    await expect(
      page.getByText(
        "Заявку должен согласовать другой сотрудник с правами администратора.",
      ),
    ).toBeVisible();
    await expect(
      page.getByRole("button", { name: "Согласовать", exact: true }),
    ).toHaveCount(0);
    owner = "other.requester";
    await page.reload();
    await page
      .getByRole("button", { name: "Согласовать", exact: true })
      .click();
    await expect(
      page.getByRole("button", { name: "Проверить и продолжить" }),
    ).toBeDisabled();
    await page
      .getByLabel("Номер или ссылка согласования")
      .fill("CHG-REQUEST-APPROVAL");
    await page.getByRole("button", { name: "Проверить и продолжить" }).click();
    expect(writes).toHaveLength(0);
    await page
      .getByRole("button", { name: "Подтвердить", exact: true })
      .click();
    await expect(
      page.getByRole("button", { name: "Выполнить в WebTerm" }),
    ).toBeDisabled();
    await page.getByRole("button", { name: "Зафиксировать проверку" }).click();
    await page
      .getByLabel("Что проверено и с каким результатом")
      .fill("Three pods ready after external operation");
    await page.getByRole("button", { name: "Проверить и продолжить" }).click();
    expect(writes).toHaveLength(1);
    await page
      .getByRole("button", { name: "Подтвердить", exact: true })
      .click();
    await expect(
      page.getByText("Подтверждена внешне", { exact: true }),
    ).toBeVisible();
    expect(writes.map((w) => w.path.split("/").at(-2))).toEqual([
      "approve-external",
      "verify-external",
    ]);
    expect(writes[1].body).toMatchObject({
      outcome: "succeeded",
      summary: "Three pods ready after external operation",
    });
    await assertNoOverflow(page);
  });
});
