// Deferred with the personal dashboard UI; see README.md in this directory.
import { randomUUID } from "node:crypto";
import {
  expect,
  test as base,
  type APIRequestContext,
  type Page,
} from "@playwright/test";
import AxeBuilder from "@axe-core/playwright";
import { assertNoOverflow, credentials, login } from "./helpers";

const path = "/settings/workspace";
const layoutPath = "/api/dashboard-custom/layout/user/";
const labels = [
  "Состояние серверов",
  "Последние операции",
  "Требуют внимания",
] as const;
const defaults = {
  columns: { main: ["servers", "activity"], side: ["alerts"] },
  hidden: [],
};

async function csrf(request: APIRequestContext) {
  const response = await request.get("/api/auth/csrf/");
  expect(response.ok()).toBeTruthy();
  return {
    "X-CSRFToken": (await response.json()).csrfToken,
    Origin: "http://127.0.0.1:8091",
  };
}

// Each scenario owns one disposable user. Deleting that account cascades to its
// personal layouts and newly created, empty projects; QA admin preferences stay untouched.
const test = base.extend<{ personal: Page }>({
  personal: async ({ page: admin, browser, baseURL }, provide) => {
    expect(baseURL, "Workspace mutations are isolated to the QA service").toBe(
      "http://127.0.0.1:8091",
    );
    await login(admin);
    const username = `qa_ux_workspace_${randomUUID().slice(0, 12)}`;
    const created = await admin.request.post("/api/access/users/", {
      headers: await csrf(admin.request),
      data: {
        username,
        password: credentials.password,
        access_profile: "custom",
        is_active: true,
        explicit_permissions: { servers: true },
      },
    });
    expect(created.ok()).toBeTruthy();
    const { user } = (await created.json()) as {
      user: { id: number; username: string };
    };
    expect(user.username).toBe(username);
    const context = await browser.newContext({
      baseURL,
      viewport: { width: 1440, height: 960 },
    });
    try {
      const auth = await context.request.post("/api/auth/login/", {
        headers: await csrf(context.request),
        data: { username, password: credentials.password, auth_mode: "local" },
      });
      expect(auth.ok()).toBeTruthy();
      const seed = await context.request.post(layoutPath, {
        headers: await csrf(context.request),
        data: { layout: { retained_preference: { value: "workspace-ux" } } },
      });
      expect(seed.ok()).toBeTruthy();
      await provide(await context.newPage());
    } finally {
      await context.close();
      const removed = await admin.request.delete(
        `/api/access/users/${user.id}/`,
        { headers: await csrf(admin.request) },
      );
      expect(
        removed.ok(),
        "Dispose only this scenario's QA account and its owned projects",
      ).toBeTruthy();
      const remaining = await admin.request.get("/api/access/users/");
      expect(
        (await remaining.json()).users.some(
          (item: { id: number }) => item.id === user.id,
        ),
      ).toBe(false);
    }
  },
});

function visibility(page: Page, label: string) {
  return page.getByRole("checkbox", {
    name: `Показывать: ${label}`,
    exact: true,
  });
}
const save = (page: Page) =>
  page.getByRole("button", { name: "Сохранить расположение", exact: true });
const reset = (page: Page) =>
  page.getByRole("button", { name: "Исходное расположение", exact: true });
const cancel = (page: Page) =>
  page.getByRole("button", { name: "Отменить изменения", exact: true });

async function openWorkspace(page: Page) {
  await page.goto(path);
  await expect(
    page.getByRole("heading", {
      level: 1,
      name: "Мой рабочий стол",
      exact: true,
    }),
  ).toBeVisible();
}
async function persist(page: Page) {
  const response = page.waitForResponse(
    (r) => r.url().endsWith(layoutPath) && r.request().method() === "POST",
  );
  await save(page).click();
  expect((await response).ok()).toBeTruthy();
  await expect(page.getByRole("status")).toContainText(
    "Персональные настройки сохранены",
  );
  await expect(save(page)).toBeDisabled();
}
async function storedLayout(page: Page) {
  const response = await page.request.get(layoutPath);
  expect(response.ok()).toBeTruthy();
  return (await response.json()).layout;
}
async function axe(page: Page) {
  const report = await new AxeBuilder({ page })
    .withTags(["wcag2a", "wcag2aa", "wcag21aa"])
    .analyze();
  expect(
    report.violations.map(({ id, nodes }) => ({
      id,
      targets: nodes.map(({ target }) => target),
    })),
  ).toEqual([]);
}

test("workspace UX: real visibility, moves, order, cancel, defaults, persistence, route guard and mobile", async ({
  personal: page,
}) => {
  test.setTimeout(75_000);
  await openWorkspace(page);
  await expect(save(page)).toBeDisabled();
  await expect(reset(page)).toBeDisabled();
  await expect(cancel(page)).toHaveCount(0);
  for (const label of labels) {
    await expect(visibility(page, label)).toBeChecked();
    await visibility(page, label).uncheck();
  }
  await expect(cancel(page)).toBeVisible();
  await cancel(page).click();
  for (const label of labels)
    await expect(visibility(page, label)).toBeChecked();
  await expect(save(page)).toBeDisabled();
  expect((await storedLayout(page)).frontend_next).toBeUndefined();

  await page
    .getByLabel("Колонка: Требуют внимания", { exact: true })
    .selectOption("main");
  await page
    .getByRole("button", { name: "Выше: Требуют внимания", exact: true })
    .click();
  await page
    .getByRole("button", { name: "Выше: Требуют внимания", exact: true })
    .click();
  await expect(
    page.getByRole("button", { name: "Выше: Требуют внимания", exact: true }),
  ).toBeDisabled();
  await page
    .getByRole("button", { name: "Ниже: Требуют внимания", exact: true })
    .click();
  await page
    .getByLabel("Колонка: Последние операции", { exact: true })
    .selectOption("side");
  await expect(
    page
      .getByRole("region", { name: "Боковая колонка", exact: true })
      .getByRole("checkbox"),
  ).toHaveAccessibleName("Показывать: Последние операции");
  await page
    .getByLabel("Колонка: Последние операции", { exact: true })
    .selectOption("main");
  await expect(
    page
      .getByRole("region", { name: "Основная колонка", exact: true })
      .getByRole("checkbox"),
  ).toHaveCount(3);
  await visibility(page, "Последние операции").uncheck();
  await persist(page);
  const stored = await storedLayout(page);
  expect(stored.retained_preference).toEqual({ value: "workspace-ux" });
  expect(stored.frontend_next.overview).toEqual({
    columns: { main: ["servers", "alerts", "activity"], side: [] },
    hidden: ["activity"],
  });
  await page.reload();
  await expect(visibility(page, "Последние операции")).not.toBeChecked();
  await expect(
    page.getByLabel("Колонка: Требуют внимания", { exact: true }),
  ).toHaveValue("main");
  await reset(page).click();
  await expect(reset(page)).toBeDisabled();
  await expect(save(page)).toBeEnabled();
  await persist(page);
  expect((await storedLayout(page)).frontend_next.overview).toEqual(defaults);

  for (const label of labels) await visibility(page, label).uncheck();
  await persist(page);
  await page.getByRole("link", { name: "Открыть обзор", exact: true }).click();
  await expect(
    page.getByRole("heading", { name: "Виджеты обзора скрыты", exact: true }),
  ).toBeVisible();
  const configure = page.getByRole("link", {
    name: "Настроить обзор",
    exact: true,
  });
  await expect(configure).toHaveAttribute("href", path);
  await configure.click();
  for (const label of labels)
    await expect(visibility(page, label)).not.toBeChecked();
  await reset(page).click();
  await persist(page);

  await visibility(page, "Состояние серверов").uncheck();
  await page.getByRole("link", { name: "Открыть обзор", exact: true }).click();
  const leave = page.getByRole("dialog", {
    name: "Выйти без сохранения?",
    exact: true,
  });
  await expect(leave).toBeVisible();
  await leave.getByRole("button", { name: "Отмена", exact: true }).click();
  await expect(page).toHaveURL(new RegExp(`${path}$`));
  await expect(visibility(page, "Состояние серверов")).not.toBeChecked();
  await page.getByRole("link", { name: "Открыть обзор", exact: true }).click();
  await leave
    .getByRole("button", { name: "Выйти без сохранения", exact: true })
    .click();
  await expect(page).toHaveURL(/\/$/);
  await openWorkspace(page);
  await expect(visibility(page, "Состояние серверов")).toBeChecked();
  await axe(page);
  await assertNoOverflow(page);
  await page.setViewportSize({ width: 390, height: 844 });
  for (const label of labels) {
    await expect(visibility(page, label)).toBeVisible();
    await expect(
      page.getByLabel(`Колонка: ${label}`, { exact: true }),
    ).toBeVisible();
    await expect(
      page.getByRole("button", { name: `Выше: ${label}`, exact: true }),
    ).toBeVisible();
    await expect(
      page.getByRole("button", { name: `Ниже: ${label}`, exact: true }),
    ).toBeVisible();
  }
  await assertNoOverflow(page);
  await axe(page);
});

test("workspace UX: dirty project switch and creation require confirmation and cancellation preserves drafts", async ({
  personal: page,
}) => {
  const name = `qa_workspace_switch_${randomUUID().slice(0, 8)}`;
  const create = await page.request.post("/api/projects/", {
    headers: await csrf(page.request),
    data: { name, activate: false },
  });
  expect(create.ok()).toBeTruthy();
  const target = (await create.json()).project as { id: string; name: string };
  const projects = async () =>
    (await (await page.request.get("/api/projects/")).json()) as {
      active_project_id: string;
      projects: { id: string; name: string }[];
    };
  const initial = await projects();
  let activations = 0;
  let creations = 0;
  page.on("request", (request) => {
    if (request.method() !== "POST") return;
    if (request.url().endsWith(`/api/projects/${target.id}/activate/`))
      activations += 1;
    if (request.url().endsWith("/api/projects/")) creations += 1;
  });
  await openWorkspace(page);
  await visibility(page, "Состояние серверов").uncheck();
  const openProjects = async () =>
    page
      .getByRole("button", { name: "Выбрать рабочий проект", exact: true })
      .click();
  const drawer = page.getByRole("dialog", {
    name: "Рабочие проекты",
    exact: true,
  });
  const guard = page.getByRole("dialog", {
    name: "Несохранённые изменения",
    exact: true,
  });
  const switchTarget = async () =>
    drawer
      .locator(".gov-project-row")
      .filter({ has: page.getByText(target.name, { exact: true }) })
      .getByRole("button", { name: "Переключить", exact: true })
      .click();
  await openProjects();
  await switchTarget();
  await expect(guard).toBeVisible();
  expect(activations).toBe(0);
  await guard.getByRole("button", { name: "Отмена", exact: true }).click();
  expect((await projects()).active_project_id).toBe(initial.active_project_id);
  await drawer.getByRole("button", { name: "Закрыть", exact: true }).click();
  await expect(visibility(page, "Состояние серверов")).not.toBeChecked();
  await openProjects();
  await switchTarget();
  await guard
    .getByRole("button", { name: "Не сохранять и переключить", exact: true })
    .click();
  await expect(drawer).toHaveCount(0);
  await expect(
    page.getByRole("button", { name: "Выбрать рабочий проект", exact: true }),
  ).toContainText(target.name);
  expect(activations).toBe(1);
  expect((await projects()).active_project_id).toBe(target.id);
  await expect(visibility(page, "Состояние серверов")).toBeChecked();

  await visibility(page, "Последние операции").uncheck();
  await openProjects();
  await drawer
    .getByRole("button", { name: "Создать проект", exact: true })
    .click();
  const form = page.getByRole("dialog", {
    name: "Создать проект",
    exact: true,
  });
  const newName = `qa_workspace_created_${randomUUID().slice(0, 8)}`;
  await form.getByLabel("Название проекта", { exact: true }).fill(newName);
  await form
    .getByRole("button", { name: "Создать и переключить", exact: true })
    .click();
  await expect(guard).toBeVisible();
  expect(creations).toBe(0);
  await guard.getByRole("button", { name: "Отмена", exact: true }).click();
  await expect(
    form.getByLabel("Название проекта", { exact: true }),
  ).toHaveValue(newName);
  expect((await projects()).projects).toHaveLength(initial.projects.length);
  await form
    .getByRole("button", { name: "Создать и переключить", exact: true })
    .click();
  await guard
    .getByRole("button", { name: "Не сохранять и создать", exact: true })
    .click();
  await expect(form).toHaveCount(0);
  await expect(
    page.getByRole("button", { name: "Выбрать рабочий проект", exact: true }),
  ).toContainText(newName);
  const result = await projects();
  expect(result.projects).toHaveLength(initial.projects.length + 1);
  expect(
    result.projects.find((project) => project.id === result.active_project_id)
      ?.name,
  ).toBe(newName);
  expect(creations).toBe(1);
  await expect(visibility(page, "Последние операции")).toBeChecked();
  await expect(cancel(page)).toHaveCount(0);
  expect((await storedLayout(page)).frontend_next).toBeUndefined();
});

test("workspace UX contract fixtures: loading and failed saves retain an honest recoverable draft", async ({
  personal: page,
}) => {
  // Only timing and 503 responses are intercepted. Successful reads and retries
  // use this disposable user's real Django persistence.
  let releaseLoad = () => {};
  const loading = new Promise<void>((resolve) => {
    releaseLoad = resolve;
  });
  let loadOutage = true;
  let saveOutage = true;
  let releaseSave = () => {};
  const saving = new Promise<void>((resolve) => {
    releaseSave = resolve;
  });
  await page.route(`**${layoutPath}`, async (route) => {
    if (route.request().method() === "GET") {
      await loading;
      if (loadOutage)
        return route.fulfill({
          status: 503,
          json: { error: "QA fixture: preferences unavailable" },
        });
    } else if (route.request().method() === "POST") {
      await saving;
      if (saveOutage)
        return route.fulfill({
          status: 503,
          json: { error: "QA fixture: save unavailable" },
        });
    }
    await route.continue();
  });
  try {
    await openWorkspace(page);
    await expect(page.getByRole("status")).toContainText("Загрузка данных…");
    await expect(save(page)).toHaveCount(0);
    await expect(page.getByRole("checkbox")).toHaveCount(0);
    releaseLoad();
    await expect(page.getByRole("alert")).toContainText(
      "QA fixture: preferences unavailable",
    );
    await expect(save(page)).toHaveCount(0);
    loadOutage = false;
    await page.getByRole("button", { name: "Повторить", exact: true }).click();
    await expect(visibility(page, "Требуют внимания")).toBeChecked();
    await visibility(page, "Требуют внимания").uncheck();
    await save(page).click();
    await expect(save(page)).toBeDisabled();
    for (const label of labels)
      await expect(visibility(page, label)).toBeDisabled();
    await expect(
      page.getByLabel("Колонка: Требуют внимания", { exact: true }),
    ).toBeDisabled();
    await expect(cancel(page)).toBeDisabled();
    releaseSave();
    await expect(page.getByRole("alert")).toContainText(
      "QA fixture: save unavailable",
    );
    await expect(visibility(page, "Требуют внимания")).not.toBeChecked();
    await expect(save(page)).toBeEnabled();
    await expect(
      page.getByText("Персональные настройки сохранены.", { exact: true }),
    ).toHaveCount(0);
    expect((await storedLayout(page)).frontend_next).toBeUndefined();
    saveOutage = false;
    await persist(page);
    await page.reload();
    await expect(visibility(page, "Требуют внимания")).not.toBeChecked();
    expect((await storedLayout(page)).frontend_next.overview.hidden).toEqual([
      "alerts",
    ]);
  } finally {
    releaseLoad();
    releaseSave();
  }
});

async function warmLayoutCache(page: Page) {
  await page.clock.install();
  const loaded = page.waitForResponse(
    (response) =>
      response.url().endsWith(layoutPath) &&
      response.request().method() === "GET",
  );
  await page.goto("/");
  expect((await loaded).ok()).toBeTruthy();
  await expect(
    page.getByRole("heading", { name: "Состояние серверов", exact: true }),
  ).toBeVisible();
  // Expire the 60-second preference cache without sleeping or changing server time.
  await page.clock.fastForward(61_000);
}

async function workspaceFromMenu(page: Page) {
  await page
    .getByRole("button", { name: "Меню аккаунта", exact: true })
    .click();
  await page
    .getByRole("menuitem", { name: "Мой рабочий стол", exact: true })
    .click();
  await expect(page).toHaveURL(new RegExp(`${path}$`));
}

test("workspace regression: a clean cached editor adopts newer background preferences", async ({
  personal: page,
}) => {
  await warmLayoutCache(page);
  const newer = {
    retained_preference: { value: "workspace-ux" },
    frontend_next: {
      version: 1,
      overview: {
        columns: { main: ["alerts", "servers"], side: ["activity"] },
        hidden: ["activity"],
      },
    },
  };
  const updated = await page.request.post(layoutPath, {
    headers: await csrf(page.request),
    data: { layout: newer },
  });
  expect(updated.ok()).toBeTruthy();
  let release = () => {};
  const pending = new Promise<void>((resolve) => {
    release = resolve;
  });
  await page.route(`**${layoutPath}`, async (route) => {
    if (route.request().method() === "GET") await pending;
    await route.continue();
  });
  try {
    const background = page.waitForRequest((request) =>
      request.url().endsWith(layoutPath),
    );
    await workspaceFromMenu(page);
    await background;
    await expect(visibility(page, "Последние операции")).toBeChecked();
    await expect(
      page.getByLabel("Колонка: Требуют внимания", { exact: true }),
    ).toHaveValue("side");
    await expect(save(page)).toBeDisabled();
    release();
    await expect(visibility(page, "Последние операции")).not.toBeChecked();
    await expect(
      page.getByLabel("Колонка: Требуют внимания", { exact: true }),
    ).toHaveValue("main");
    await expect(
      page.getByLabel("Колонка: Последние операции", { exact: true }),
    ).toHaveValue("side");
    const main = page
      .getByRole("region", { name: "Основная колонка", exact: true })
      .getByRole("checkbox");
    await expect(main.nth(0)).toHaveAccessibleName(
      "Показывать: Требуют внимания",
    );
    await expect(main.nth(1)).toHaveAccessibleName(
      "Показывать: Состояние серверов",
    );
    await expect(save(page)).toBeDisabled();
    await expect(cancel(page)).toHaveCount(0);
    expect((await storedLayout(page)).frontend_next.overview).toEqual(
      newer.frontend_next.overview,
    );
  } finally {
    release();
  }
});

test("workspace regression: a background 503 retains dirty controls and their unsaved guard", async ({
  personal: page,
}) => {
  await warmLayoutCache(page);
  let release = () => {};
  const pending = new Promise<void>((resolve) => {
    release = resolve;
  });
  let outage = true;
  await page.route(`**${layoutPath}`, async (route) => {
    if (route.request().method() === "GET") {
      await pending;
      if (outage)
        return route.fulfill({
          status: 503,
          json: { error: "QA regression: background preferences unavailable" },
        });
    }
    await route.continue();
  });
  try {
    const background = page.waitForRequest((request) =>
      request.url().endsWith(layoutPath),
    );
    await workspaceFromMenu(page);
    await background;
    await visibility(page, "Требуют внимания").uncheck();
    await page
      .getByLabel("Колонка: Требуют внимания", { exact: true })
      .selectOption("main");
    release();
    await expect(page.getByRole("alert")).toContainText(
      "QA regression: background preferences unavailable",
    );
    await expect(visibility(page, "Требуют внимания")).not.toBeChecked();
    await expect(
      page.getByLabel("Колонка: Требуют внимания", { exact: true }),
    ).toHaveValue("main");
    await expect(save(page)).toBeEnabled();
    await expect(cancel(page)).toBeVisible();
    await page
      .getByRole("link", { name: "Открыть обзор", exact: true })
      .click();
    const guard = page.getByRole("dialog", {
      name: "Выйти без сохранения?",
      exact: true,
    });
    await expect(guard).toBeVisible();
    await guard.getByRole("button", { name: "Отмена", exact: true }).click();
    await expect(visibility(page, "Требуют внимания")).not.toBeChecked();
    outage = false;
    await page.getByRole("button", { name: "Повторить", exact: true }).click();
    await expect(page.getByRole("alert")).toHaveCount(0);
    await expect(visibility(page, "Требуют внимания")).not.toBeChecked();
    await expect(
      page.getByLabel("Колонка: Требуют внимания", { exact: true }),
    ).toHaveValue("main");
    await persist(page);
    expect((await storedLayout(page)).frontend_next.overview).toEqual({
      columns: { main: ["servers", "activity", "alerts"], side: [] },
      hidden: ["alerts"],
    });
  } finally {
    release();
  }
});

test("workspace regression: a pending save locks route discard and blocks project activation until it finishes", async ({
  personal: page,
}) => {
  const created = await page.request.post("/api/projects/", {
    headers: await csrf(page.request),
    data: {
      name: `qa_workspace_pending_${randomUUID().slice(0, 8)}`,
      activate: false,
    },
  });
  expect(created.ok()).toBeTruthy();
  const target = (await created.json()).project as { id: string; name: string };
  await openWorkspace(page);
  let release = () => {};
  let pending = new Promise<void>((resolve) => {
    release = resolve;
  });
  await page.route(`**${layoutPath}`, async (route) => {
    if (route.request().method() === "POST") await pending;
    await route.continue();
  });
  try {
    await visibility(page, "Состояние серверов").uncheck();
    const saving = page.waitForRequest(
      (request) =>
        request.url().endsWith(layoutPath) && request.method() === "POST",
    );
    await save(page).click();
    await saving;
    await page
      .getByRole("link", { name: "Открыть обзор", exact: true })
      .click();
    const leave = page.getByRole("dialog", {
      name: "Выйти без сохранения?",
      exact: true,
    });
    await expect(leave).toBeVisible();
    await expect(leave).toContainText("Сохранение уже началось");
    await expect(
      leave.getByRole("button", { name: "Выйти без сохранения", exact: true }),
    ).toBeDisabled();
    await expect(
      leave.getByRole("button", { name: "Отмена", exact: true }),
    ).toBeDisabled();
    await page.keyboard.press("Escape");
    await expect(leave).toBeVisible();
    await expect(page).toHaveURL(new RegExp(`${path}$`));
    release();
    await expect(page).toHaveURL(/\/$/);
    expect((await storedLayout(page)).frontend_next.overview.hidden).toEqual([
      "servers",
    ]);

    await openWorkspace(page);
    await expect(visibility(page, "Состояние серверов")).not.toBeChecked();
    await visibility(page, "Последние операции").uncheck();
    pending = new Promise<void>((resolve) => {
      release = resolve;
    });
    const secondSave = page.waitForRequest(
      (request) =>
        request.url().endsWith(layoutPath) && request.method() === "POST",
    );
    await save(page).click();
    await secondSave;
    let activations = 0;
    page.on("request", (request) => {
      if (
        request.method() === "POST" &&
        request.url().endsWith(`/api/projects/${target.id}/activate/`)
      )
        activations += 1;
    });
    await page
      .getByRole("button", { name: "Выбрать рабочий проект", exact: true })
      .click();
    const drawer = page.getByRole("dialog", {
      name: "Рабочие проекты",
      exact: true,
    });
    const activate = drawer
      .locator(".gov-project-row")
      .filter({ has: page.getByText(target.name, { exact: true }) })
      .getByRole("button", { name: "Переключить", exact: true });
    await activate.click();
    await expect(drawer.getByRole("alert")).toContainText(
      "Дождитесь завершения сохранения на текущей странице.",
    );
    await expect(
      page.getByRole("dialog", {
        name: "Несохранённые изменения",
        exact: true,
      }),
    ).toHaveCount(0);
    expect(activations).toBe(0);
    expect(
      (await (await page.request.get("/api/projects/")).json())
        .active_project_id,
    ).not.toBe(target.id);
    release();
    await expect(page.locator(".dashboard-editor")).not.toHaveAttribute(
      "disabled",
      "",
    );
    await activate.click();
    await expect(drawer).toHaveCount(0);
    expect(activations).toBe(1);
    await expect(
      page.getByRole("button", { name: "Выбрать рабочий проект", exact: true }),
    ).toContainText(target.name);
    expect((await storedLayout(page)).frontend_next.overview.hidden).toEqual([
      "servers",
      "activity",
    ]);
    await expect(cancel(page)).toHaveCount(0);
  } finally {
    release();
  }
});
