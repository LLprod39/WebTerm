// Historical tests for removed Team activity and personal dashboard UI. See README.md.
import { expect, test, type Page } from "@playwright/test";
import { credentials, login, assertNoOverflow } from "./helpers";

test.use({ actionTimeout: 15_000, navigationTimeout: 20_000 });

type User = {
  id: number;
  username: string;
  email: string;
  is_active: boolean;
  groups: { id: number; name: string }[];
  explicit_permissions: Record<string, boolean>;
  effective_permissions: Record<string, boolean>;
  permission_sources: Record<string, string>;
};
type Group = { id: number; name: string; members: { id: number }[] };
async function headers(page: Page) {
  const response = await page.request.get("/api/auth/csrf/");
  const body = await response.json();
  return { "X-CSRFToken": body.csrfToken, Origin: "http://127.0.0.1:8091" };
}
async function userByName(
  page: Page,
  username: string,
): Promise<User | undefined> {
  const response = await page.request.get("/api/access/users/");
  expect(response.ok()).toBeTruthy();
  return ((await response.json()).users as User[]).find(
    (user) => user.username === username,
  );
}
async function cleanup(page: Page, username: string, groupName?: string) {
  // Only entities generated by this test are eligible for cleanup.
  expect(username.startsWith("qa_gov_")).toBeTruthy();
  const authHeaders = await headers(page);
  const user = await userByName(page, username);
  if (user)
    await page.request.delete(`/api/access/users/${user.id}/`, {
      headers: authHeaders,
    });
  if (groupName) {
    expect(groupName.startsWith("qa_gov_")).toBeTruthy();
    const response = await page.request.get("/api/access/groups/");
    const group = ((await response.json()).groups as Group[]).find(
      (item) => item.name === groupName,
    );
    if (group)
      await page.request.delete(`/api/access/groups/${group.id}/`, {
        headers: authHeaders,
      });
  }
}
async function openUser(page: Page, username: string) {
  await page.goto("/governance/users");
  await page.getByPlaceholder("Найти пользователя или группу").fill(username);
  await page
    .getByRole("row")
    .filter({ hasText: username })
    .getByRole("button", { name: "Настроить", exact: true })
    .click();
  await expect(page.getByRole("dialog")).toBeVisible();
}
test.beforeEach(async ({ baseURL }) => {
  expect(
    baseURL,
    "Governance writes must stay on the isolated QA service",
  ).toBe("http://127.0.0.1:8091");
});

test("admin activity, event filters and provider billing use the live contracts", async ({
  page,
}) => {
  test.setTimeout(120_000);
  const errors: string[] = [];
  page.on("pageerror", (error) => errors.push(error.message));
  await login(page);
  await page.goto("/governance/activity");
  await expect(
    page.getByRole("heading", {
      name: "Пользователи за последние 5 минут",
      exact: true,
    }),
  ).toBeVisible();
  await expect(
    page.getByRole("checkbox", {
      name: "Обновлять каждые 30 секунд",
      exact: true,
    }),
  ).toBeChecked();
  await page
    .getByRole("checkbox", { name: "Обновлять каждые 30 секунд", exact: true })
    .uncheck();
  const sessionsResponse = await page.request.get("/api/admin/users/sessions/");
  expect(sessionsResponse.ok()).toBeTruthy();
  const sessions = await sessionsResponse.json();
  await expect(
    page
      .locator(".gov-metrics .metric")
      .filter({ hasText: "Всего учётных записей" }),
  ).toContainText(String(sessions.total_registered));
  await page.getByRole("tab", { name: "События", exact: true }).click();
  await page
    .getByLabel("Поиск событий", { exact: true })
    .fill(credentials.admin.username);
  const filtered = page.waitForResponse(
    (response) =>
      response.url().includes("/api/admin/users/activity/") &&
      new URL(response.url()).searchParams.get("search") ===
        credentials.admin.username,
  );
  await page.getByRole("button", { name: "Применить", exact: true }).click();
  const eventsResponse = await filtered;
  expect(eventsResponse.ok()).toBeTruthy();
  const events = await eventsResponse.json();
  expect(events.total).toBeGreaterThan(0);
  await expect(
    page
      .getByRole("row")
      .filter({ hasText: credentials.admin.username })
      .first(),
  ).toBeVisible();
  await page
    .getByRole("button", { name: "Открыть", exact: true })
    .first()
    .click();
  await expect(page.getByRole("dialog")).toContainText(
    credentials.admin.username,
  );
  await page
    .getByRole("dialog")
    .getByRole("button", { name: "Закрыть", exact: true })
    .click();
  await page
    .getByRole("tab", { name: "Использование AI", exact: true })
    .click();
  await expect(
    page.getByRole("heading", { name: "Использование AI", exact: true }),
  ).toBeVisible({ timeout: 45_000 });
  await expect(
    page.getByRole("columnheader", { name: "Факт, USD", exact: true }),
  ).toBeVisible();
  await page
    .getByRole("button", { name: "Подробности", exact: true })
    .first()
    .click();
  await expect(page.getByRole("dialog")).toContainText("Источник данных");
  await page
    .getByRole("dialog")
    .getByRole("button", { name: "Закрыть", exact: true })
    .click();
  await assertNoOverflow(page);
  expect(errors).toEqual([]);
});

test("personal dashboard layout persists, preserves unrelated data and changes the overview", async ({
  page,
  browser,
}) => {
  test.setTimeout(120_000);
  const username = `qa_gov_layout_${Date.now()}`;
  await login(page);
  const create = await page.request.post("/api/access/users/", {
    headers: await headers(page),
    data: {
      username,
      password: credentials.password,
      access_profile: "custom",
      is_active: true,
      explicit_permissions: { servers: true },
    },
  });
  expect(create.ok()).toBeTruthy();
  const context = await browser.newContext({
    baseURL: "http://127.0.0.1:8091",
  });
  try {
    const personal = await context.newPage();
    const authHeaders = await headers(personal);
    const auth = await context.request.post("/api/auth/login/", {
      headers: authHeaders,
      data: { username, password: credentials.password, auth_mode: "local" },
    });
    expect(auth.ok()).toBeTruthy();
    // Seed only this disposable user's unrelated preference to verify preservation.
    const seed = await context.request.post(
      "/api/dashboard-custom/layout/user/",
      {
        headers: await headers(personal),
        data: { layout: { retained_preference: { value: "qa" } } },
      },
    );
    expect(seed.ok()).toBeTruthy();
    await personal.goto("/settings/workspace");
    await personal
      .getByRole("checkbox", {
        name: "Показывать: Последние операции",
        exact: true,
      })
      .uncheck();
    await personal
      .getByLabel("Колонка: Требуют внимания", { exact: true })
      .selectOption("main");
    await personal
      .getByRole("button", { name: "Выше: Требуют внимания", exact: true })
      .click();
    await personal
      .getByRole("button", { name: "Сохранить расположение", exact: true })
      .click();
    await expect(personal.getByRole("status")).toContainText(
      "Персональные настройки сохранены",
    );
    const saved = await context.request.get(
      "/api/dashboard-custom/layout/user/",
    );
    const savedLayout = (await saved.json()).layout;
    expect(savedLayout.retained_preference).toEqual({ value: "qa" });
    expect(savedLayout.frontend_next.overview.columns.main).toEqual([
      "servers",
      "alerts",
      "activity",
    ]);
    expect(savedLayout.frontend_next.overview.hidden).toEqual(["activity"]);
    await personal.reload();
    await expect(
      personal.getByRole("checkbox", {
        name: "Показывать: Последние операции",
        exact: true,
      }),
    ).not.toBeChecked();
    await personal
      .getByRole("link", { name: "Открыть обзор", exact: true })
      .click();
    await expect(
      personal.getByRole("heading", {
        name: "Обзор инфраструктуры",
        exact: true,
      }),
    ).toBeVisible();
    await expect(
      personal.getByRole("heading", {
        name: "Последние операции",
        exact: true,
      }),
    ).toHaveCount(0);
    await expect(
      personal
        .locator(".dashboard-sections > .stack")
        .first()
        .getByRole("heading", { level: 2 }),
    ).toHaveText(["Состояние серверов", "Требуют внимания"]);
    await personal.goto("/settings/workspace");
    await personal
      .getByRole("checkbox", {
        name: "Показывать: Последние операции",
        exact: true,
      })
      .check();
    await personal
      .getByRole("link", { name: "Открыть обзор", exact: true })
      .click();
    await expect(
      personal.getByRole("dialog", { name: "Выйти без сохранения?" }),
    ).toBeVisible();
    await personal
      .getByRole("dialog")
      .getByRole("button", { name: "Отмена", exact: true })
      .click();
    await personal
      .getByRole("button", { name: "Исходное расположение", exact: true })
      .click();
    await personal
      .getByRole("button", { name: "Сохранить расположение", exact: true })
      .click();
    await expect(personal.getByRole("status")).toContainText(
      "Персональные настройки сохранены",
    );
    const reset = (
      await (
        await context.request.get("/api/dashboard-custom/layout/user/")
      ).json()
    ).layout;
    expect(reset.frontend_next.overview).toEqual({
      columns: { main: ["servers", "activity"], side: ["alerts"] },
      hidden: [],
    });
    await assertNoOverflow(personal);
  } finally {
    await context.close();
    await cleanup(page, username);
  }
});
