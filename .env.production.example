# =============================================================================
# WebTerm production environment
# Copy to .env.production and replace the placeholder values that fit your host.
# Main startup command:
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
# =============================================================================

# CATEGORY: REQUIRED — installation identity, secrets, database, and baseline security

# -----------------------------------------------------------------------------
# Public URLs and ports
# -----------------------------------------------------------------------------
PUBLIC_BIND_HOST=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
FRONTEND_PORT=8080
DJANGO_BIND_HOST=127.0.0.1
DJANGO_HOST_PORT=9000
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379
TZ=Asia/Qyzylorda

SITE_URL=https://webterm.example.com
FRONTEND_APP_URL=https://webterm.example.com
ALLOWED_HOSTS=webterm.example.com
CSRF_TRUSTED_ORIGINS=https://webterm.example.com

# -----------------------------------------------------------------------------
# Django / app mode
# -----------------------------------------------------------------------------
WEU_BUILD=prod
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters
MANAGED_SECRET_KEY=replace-with-a-long-random-managed-secret-key-at-least-50-characters
# Optional stable label. If blank, a non-secret id is derived from MANAGED_SECRET_KEY.
MANAGED_SECRET_KEY_ID=
# JSON object of old key ids to old keys, used only during zero-downtime rotation.
MANAGED_SECRET_PREVIOUS_KEYS={}
MODEL_CONFIG_PATH=/workspace/config_runtime/model_config.json
NOTIFICATION_CONFIG_PATH=/workspace/config_runtime/notification_config.json
CHANNEL_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Numeric group owner of /var/run/docker.sock. Only the filtered socket proxy
# receives this group; the playbook worker never mounts the host socket.
DOCKER_SOCKET_GID=
WEBTERM_PLAYBOOK_DOCKER_PROXY_IMAGE=webterm-playbook-docker-proxy:latest
WEBTERM_AGENT_COMMAND_DOCKER_PROXY_IMAGE=webterm-agent-command-docker-proxy:latest
WEBTERM_BACKEND_MEMORY=1g
WEBTERM_BACKEND_CPUS=2.0
WEBTERM_BACKEND_PIDS_LIMIT=512
WEBTERM_BACKEND_WORKER_MEMORY=768m
WEBTERM_BACKEND_WORKER_CPUS=1.0
WEBTERM_BACKEND_WORKER_PIDS_LIMIT=256

# v0.1 release scope: fail closed until external KMS/scanner/sandbox evidence
# is provisioned. "disabled" removes backend routes/providers and frontend UI.
PLUGIN_MARKETPLACE_RELEASE_MODE=disabled

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weu_platform
POSTGRES_USER=weu
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_CONN_MAX_AGE_SECONDS=60

# -----------------------------------------------------------------------------
# Security / cookies / headers
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=true
TRUST_X_FORWARDED_PROTO=true
# nginx is the single trusted hop in the bundled production topology.
TRUSTED_PROXY_HOPS=1
AUTH_LOGIN_FAILURE_LIMIT=10
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_USERNAME_SOFT_LIMIT=50
AUTH_LOGIN_USERNAME_WINDOW_SECONDS=3600
AUTH_LOGIN_USERNAME_BASE_DELAY_MS=125
AUTH_LOGIN_USERNAME_MAX_DELAY_MS=2000
USE_X_FORWARDED_HOST=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# CATEGORY: COMMON — settings operators commonly change without redesigning topology

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
APP_LOG_FILE=/workspace/logs/webtrerm.log
APP_LOG_LEVEL=INFO
APP_LOG_ROTATION=50 MB
APP_LOG_RETENTION=14 days
APP_LOG_SYSLOG_ENABLED=false
APP_LOG_SYSLOG_ADDRESS=localhost:514
APP_LOG_SYSLOG_PROTOCOL=udp
APP_LOG_SYSLOG_FACILITY=LOG_USER

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
CODEX_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
# Optional Operator public web research (Brave Search API)
WEB_SEARCH_API_KEY=
LLM_GROK_STREAM_TIMEOUT_SECONDS=3600
LLM_GROK_REASONING_EFFORT=none
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# -----------------------------------------------------------------------------
# Cursor / CLI runtime
# -----------------------------------------------------------------------------
CURSOR_API_KEY=
CURSOR_CLI_HTTP_1=1
CURSOR_CLI_EXTRA_ENV=
CLI_RUNTIME_TIMEOUT_SECONDS=600
CLI_FIRST_OUTPUT_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Email / Telegram notifications
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PIPELINE_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
# Assigned only to the telegram-bot consumer by the production topology.
# Other services may send through TELEGRAM_BOT_TOKEN but cannot call getUpdates.
TELEGRAM_CHAT_ID=

# CATEGORY: EXPERT — enterprise integrations, worker sizing, retention, and trust boundaries

# -----------------------------------------------------------------------------
# Domain auth / SSO
# -----------------------------------------------------------------------------
DOMAIN_AUTH_ENABLED=false
DOMAIN_AUTH_HEADER=REMOTE_USER
DOMAIN_AUTH_HEADER_ALIASES=
DOMAIN_AUTH_AUTO_CREATE=true
DOMAIN_AUTH_LOWERCASE_USERNAMES=true
DOMAIN_AUTH_DEFAULT_PROFILE=pilot_user

# -----------------------------------------------------------------------------
# LDAP / AD
# -----------------------------------------------------------------------------
LOCAL_ADMIN_USERNAMES=admin
LDAP_PASSWORD_LOGIN_ENFORCED=true
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_PORT=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_FILTER=(objectClass=user)
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_FULL_NAME_ATTRIBUTE=cn
LDAP_START_TLS=false
LDAP_IGNORE_CERT=false
LDAP_NETWORK_TIMEOUT_SECONDS=3
# If you need a private CA, put it under ./docker/ldap and use the container path, for example:
# LDAP_CA_CERT_FILE=/etc/webtrerm/ldap/company-ca.pem
LDAP_CA_CERT_FILE=
LDAP_CA_CERT_DIR=

# -----------------------------------------------------------------------------
# Studio MCP HTTP/SSE destinations
# -----------------------------------------------------------------------------
# Private MCP hosts are denied unless explicitly listed here. Keep this list
# narrow: runtime requests pin the validated address and never follow redirects.
STUDIO_MCP_SSE_TRUSTED_PRIVATE_HOSTS=

# -----------------------------------------------------------------------------
# MCP Runner: one supervisor container that runs stdio MCP servers isolated from
# the backend host and reuses them across calls (no per-call cold start).
# When STUDIO_MCP_RUNNER_URL is set, stdio MCP servers run in the runner and
# become available to non-admin users. Leave STUDIO_MCP_RUNNER_URL empty to keep
# the legacy behaviour (stdio runs on the backend host, admin-only in prod).
# ALWAYS set STUDIO_MCP_RUNNER_TOKEN to a strong random secret so only the
# backend can reach the runner: e.g. `openssl rand -hex 32`.
# -----------------------------------------------------------------------------
STUDIO_MCP_RUNNER_URL=http://mcp-runner:9000
STUDIO_MCP_RUNNER_TOKEN=
# Optional runner tuning:
MCP_RUNNER_SESSION_TTL_SECONDS=300
MCP_RUNNER_MAX_SESSIONS=50
MCP_RUNNER_REQUEST_TIMEOUT_SECONDS=120
# Keep stdio admin-only even with the runner on (set true to restrict):
# STUDIO_MCP_STDIO_ADMIN_ONLY=false

# -----------------------------------------------------------------------------
# Production background workers
# -----------------------------------------------------------------------------
PIPELINE_SCHEDULER_INTERVAL=60
PIPELINE_EXECUTION_INTERVAL_SECONDS=5
PIPELINE_EXECUTION_LEASE_SECONDS=180
PIPELINE_EXECUTION_GLOBAL_CONCURRENCY=4
PIPELINE_EXECUTION_PER_USER_CONCURRENCY=2
PIPELINE_EXECUTION_MAX_ATTEMPTS=3
# Five replicas with two local slots provide ten parallel agent runs. The
# database caps remain authoritative across every replica and process.
AGENT_EXECUTION_REPLICAS=5
AGENT_EXECUTION_WORKER_CONCURRENCY=2
AGENT_EXECUTION_GLOBAL_CONCURRENCY=10
AGENT_EXECUTION_PER_USER_CONCURRENCY=2
AGENT_EXECUTION_INTERVAL=2
AGENT_EXECUTION_LEASE_SECONDS=180
AGENT_ACTIVE_RUNS_PER_USER_LIMIT=5
AGENT_ACTIVE_RUNS_GLOBAL_LIMIT=25
APP_RATE_LIMIT_ASSISTANT_PER_MINUTE=30
APP_RATE_LIMIT_PIPELINE_RUNS_PER_MINUTE=10
APP_RATE_LIMIT_AGENT_RUNS_PER_MINUTE=10
SSH_POOL_IDLE_TTL_SECONDS=60
SSH_POOL_MAX_PER_SERVER=4
SSH_POOL_MAX_CONNECTIONS=50
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
SCHEDULED_AGENTS_INTERVAL=60
SCHEDULED_AGENTS_LIMIT=100
# Durable Ansible playbook queue. Scale the worker service separately; every
# replica shares this database-enforced global claim limit.
PLAYBOOK_EXECUTION_INTERVAL_SECONDS=5
PLAYBOOK_EXECUTION_LEASE_SECONDS=180
PLAYBOOK_EXECUTION_GLOBAL_CONCURRENCY=4
PLAYBOOK_EXECUTION_PER_USER_CONCURRENCY=2
PLAYBOOK_RUNTIME_VOLUME_NAME=mini_prod_playbook_runtime
WEBTERM_ANSIBLE_IMAGE=webterm-ansible:latest
WEBTERM_BACKEND_IMAGE=webterm-backend:latest
WEBTERM_FRONTEND_IMAGE=webterm-frontend:latest
WEBTERM_MCP_RUNNER_IMAGE=webterm-mcp-runner:latest
# MARS stays fail-closed until a reviewed release image is published. To
# enable it, set an exact registry reference: repository@sha256:<64 hex>.
MARS_AGENT_DOCKER_IMAGE=
# Agent SSH commands stay fail-closed until this runner image is built,
# published and pinned as repository@sha256:<64 lowercase hex>. The production
# installer fills a local sha256 image ID automatically when builds are enabled.
AGENT_COMMAND_RUNTIME=docker

# OpenTelemetry / OTLP over HTTP. Keep REQUIRED=false until a collector is
# reachable, then enable both the SDK and the deploy gate.
WEBTERM_OTEL_REQUIRED=false
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=webterm
WEBTERM_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_METRIC_EXPORT_INTERVAL=30000
# The built-in observability profile binds Grafana to loopback only. Reach it
# through an SSH/VPN tunnel or an operator-managed TLS reverse proxy.
# Grafana nightly and Tempo main are reviewed clean upstream snapshots; all six
# images are digest-pinned and require the full Linux observability smoke before GO.
WEBTERM_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0@sha256:c5918f78992ee73b0d6f0e599423ac5ec52dd5d9726733114d6eca53d5a32ed5
WEBTERM_PROMETHEUS_IMAGE=prom/prometheus:v3.13.2-distroless@sha256:64f71bb84e03c855948418b0fc5dea53e9543d8e3fc9931598f583805507f05e
WEBTERM_ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager:main@sha256:a42c3e2e8f7cd4fd3a0ce1bd593ca5abe965c97b993476007d6f69c4a2aa33b5
WEBTERM_GRAFANA_IMAGE=grafana/grafana:nightly-distroless-slim@sha256:b2c2fd5391216bd57e6bad74c0dce05f8e275479e1153ab57149a4f019a3dceb
WEBTERM_TEMPO_IMAGE=grafana/tempo:main-1a8b052-2010-1@sha256:78dc87894e9eb054b0229980ac3e7f099b437aec07a8731612373fc09b7f8ba0
WEBTERM_LOKI_IMAGE=grafana/loki:3.7.6@sha256:efd47c67f9bac88ca29bcf8cb997d9ab29d1848bd0aff579282295542a745952
PROMETHEUS_RETENTION=30d
ALERTMANAGER_RETENTION=336h
LOKI_RETENTION_PERIOD=336h
TEMPO_RETENTION=336h
# Mode-600 file containing exactly one HTTPS notification webhook URL. The URL
# stays out of Compose environment/log output and is read by Alertmanager only.
ALERTMANAGER_WEBHOOK_URL_FILE=/etc/webterm/alertmanager.webhook-url
GRAFANA_ADMIN_USER=webterm-admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=https://grafana.webterm.example.com
GRAFANA_COOKIE_SECURE=true
AGENT_COMMAND_RUNNER_IMAGE=
AGENT_COMMAND_DOCKER_NETWORK=bridge
AGENT_COMMAND_DOCKER_CPUS=0.5
AGENT_COMMAND_DOCKER_MEMORY=256m
AGENT_COMMAND_DOCKER_PIDS_LIMIT=64
AGENT_COMMAND_TIMEOUT_SECONDS=120
AGENT_COMMAND_OUTPUT_MAX_CHARS=100000

# Subscription CLI providers (Codex/Grok). Disabled until the dedicated
# provider image is built, its immutable sha256 image ID is pinned below, and
# a strong internal manager token is generated. Never put provider OAuth
# tokens here; device login writes only to isolated named Docker volumes.
AI_CLI_SUBSCRIPTIONS_ENABLED=false
AI_CLI_RUNNER_MANAGER_TOKEN=
AI_CLI_CODEX_RUNNER_IMAGE=
AI_CLI_GROK_RUNNER_IMAGE=
AI_CLI_RUNNER_MANAGER_URL=http://ai-cli-runner-manager:9000
AI_CLI_DOCKER_NETWORK=webterm-ai-cli-egress
AI_CLI_CREDENTIAL_VOLUME_PREFIX=webterm-ai-cli-cred-
AI_CLI_EGRESS_PROXY_URL=http://ai-cli-egress-proxy:3128
AI_CLI_DOCKER_CPUS=1.0
AI_CLI_DOCKER_MEMORY=1g
AI_CLI_DOCKER_PIDS_LIMIT=128
AI_CLI_REQUEST_TIMEOUT_SECONDS=900
AI_CLI_OUTPUT_LIMIT_BYTES=2097152
AI_CLI_INTERACTIVE_CAPACITY_WAIT_SECONDS=30
AI_CLI_UNATTENDED_CAPACITY_WAIT_SECONDS=300
AI_CLI_AUTH_WORKER_INTERVAL_SECONDS=2
# One auth worker handles device flows asynchronously. The management command
# enforces the same fail-closed pilot range of 1..8; four is the pilot default.
AI_CLI_AUTH_WORKER_CONCURRENCY=4
WEBTERM_AI_CLI_DOCKER_PROXY_IMAGE=
WEBTERM_AI_CLI_EGRESS_PROXY_IMAGE=
WEBTERM_AI_CLI_RUNNER_MANAGER_IMAGE=
# Build-only inputs for docker/ai-cli-provider-runner.Dockerfile. Pin the exact
# approved official Grok Build binary and checksum; an empty value fails build.
GROK_BUILD_URL=
GROK_BUILD_SHA256=

# Mandatory for the AI CLI pilot. Hostnames/IPs are exact allowlist entries;
# every resolved address must also be inside an explicit strict CIDR. Empty
# lists deny every SSH destination. Keep production and Compose service names
# out of this list; only disposable/snapshot-capable test targets belong here.
PILOT_RESTRICTED_MODE=true
PILOT_SSH_ALLOWED_HOSTS=
PILOT_SSH_ALLOWED_CIDRS=
PILOT_SSH_ALLOWED_PORTS=22

# Encrypted PostgreSQL plus media/config/playbook-bundle backups. AI credential,
# log and telemetry volumes are intentionally excluded. The recipient file
# contains only the public age recipient; keep the private identity outside the
# repository and production env.
BACKUP_AGE_RECIPIENT_FILE=/etc/webterm/backup.age.recipient
BACKUP_DIR=./backups/postgres
BACKUP_STATUS_DIR=./backups/status
WEBTERM_ANSIBLE_DOCKER_NETWORK=bridge
WEBTERM_ANSIBLE_DOCKER_CPUS=1.0
WEBTERM_ANSIBLE_DOCKER_MEMORY=512m
WEBTERM_ANSIBLE_RUNTIME_TTL_SECONDS=7200
ANSIBLE_VALIDATOR_MAX_CONCURRENCY=4
ANSIBLE_VALIDATOR_READ_TIMEOUT_SECONDS=10
MONITOR_QUICK_INTERVAL=300
MONITOR_DEEP_INTERVAL=600
MONITOR_CONCURRENCY=5
MEMORY_DREAM_INTERVAL=300
WATCHERS_INTERVAL=120
WATCHERS_LIMIT=100
SERVER_BULK_WORKER_INTERVAL_SECONDS=2
SERVER_BULK_WORKER_LEASE_SECONDS=90
CELERY_LOG_LEVEL=info
CELERY_WORKER_CONCURRENCY=2
KUBERNETES_OPS_SYNC_INTERVAL_SECONDS=300
KUBERNETES_OPS_SYNC_MAX_BACKOFF_SECONDS=1800
KUBERNETES_OPS_STALE_AFTER_SECONDS=900
KUBERNETES_OPS_AUDIT_RETENTION_DAYS=365
KUBERNETES_OPS_READY_FOR_SIDEBAR=false
# Closed pilot: waive production-only release_scope evidence (still need READY_FOR_SIDEBAR=true + runtime checks)
KUBERNETES_OPS_PILOT_SIDEBAR=false
KUBERNETES_OPS_RELEASE_ENVIRONMENT=local
KUBERNETES_OPS_PRODUCTION_APPROVAL_REF=
KUBERNETES_OPS_PRODUCTION_EVIDENCE_REF=
KUBERNETES_OPS_IDENTITY_RUNTIME_EVIDENCE_REF=
KUBERNETES_OPS_LIVE_PROVIDER_EVIDENCE_REF=
KUBERNETES_OPS_READONLY_RBAC_EVIDENCE_REF=
KUBERNETES_OPS_KUBERNETES_MCP_EVIDENCE_REF=
KUBERNETES_OPS_PRODUCTION_ROLLBACK_EVIDENCE_REF=
KUBERNETES_OPS_PRODUCTION_NATIVE_VERIFICATION_EVIDENCE_REF=
KUBERNETES_OPS_RELEASE_EVIDENCE_MAX_AGE_SECONDS=86400
KUBERNETES_ADMIN_MODE_ENABLED=false
KUBERNETES_ACTION_REQUEST_NATIVE_EXECUTION_ENABLED=false
KUBERNETES_ADMIN_NATIVE_APPLY_ENABLED=false
KUBERNETES_ADMIN_BREAK_GLASS_APPLY_BYPASS_ENABLED=false
KUBERNETES_ADMIN_DRY_RUN_PROOF_MAX_AGE_SECONDS=1800
KUBERNETES_ADMIN_SECRET_READ_ENABLED=false
KUBERNETES_ADMIN_NATIVE_PATCH_ENABLED=false
KUBERNETES_ADMIN_PATCH_MAX_BODY_BYTES=65536
KUBERNETES_ADMIN_NATIVE_SCALE_ENABLED=false
KUBERNETES_ADMIN_NATIVE_RESTART_ENABLED=false
KUBERNETES_ADMIN_SCALE_MAX_REPLICAS=100
KUBERNETES_ADMIN_NATIVE_DELETE_ENABLED=false
KUBERNETES_ADMIN_DELETE_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease,cattle-system,cattle-fleet-system,cattle-fleet-local-system,cert-manager,ingress-nginx,devtroncd,argocd,monitoring,logging,local
KUBERNETES_ADMIN_NATIVE_NODE_MAINTENANCE_ENABLED=false
KUBERNETES_ADMIN_NODE_DRAIN_EXECUTION_ENABLED=false
KUBERNETES_ADMIN_NATIVE_EXEC_ENABLED=false
KUBERNETES_ADMIN_EXEC_STREAMING_ENABLED=false
KUBERNETES_ADMIN_EXEC_RECORDING_ENABLED=false
KUBERNETES_ADMIN_EXEC_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease,cattle-system,cattle-fleet-system,cattle-fleet-local-system,cert-manager,ingress-nginx,devtroncd,argocd,monitoring,logging,local
KUBERNETES_ADMIN_EXEC_ALLOWED_COMMANDS=/bin/sh,/bin/bash,sh,bash,env,printenv,ls,cat,curl,wget,tail,head,grep,sed,awk,ps,df,du,whoami,hostname,uname,stat
KUBERNETES_ADMIN_EXEC_DENIED_COMMANDS=kubectl,helm,sudo,su,nsenter,mount,umount,chroot,iptables,ip6tables,nft,ssh,scp,nc,netcat,socat,docker,crictl,ctr,nerdctl,apk,apt,apt-get,yum,dnf,rpm,pip,pip3,python,python3,perl,ruby,node,npm,npx,yarn,pnpm,dd,mkfs,reboot,shutdown,kill,killall
KUBERNETES_ADMIN_NATIVE_PORT_FORWARD_ENABLED=false
KUBERNETES_ADMIN_PORT_FORWARD_TUNNEL_ENABLED=false
KUBERNETES_ADMIN_PORT_FORWARD_RECORDING_ENABLED=false
KUBERNETES_ADMIN_PORT_FORWARD_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease,cattle-system,cattle-fleet-system,cattle-fleet-local-system,cert-manager,ingress-nginx,devtroncd,argocd,monitoring,logging,local
KUBERNETES_ADMIN_PORT_FORWARD_ALLOWED_TARGETS=
KUBERNETES_ADMIN_PORT_FORWARD_MAX_DURATION_SECONDS=900
KUBERNETES_ADMIN_PORT_FORWARD_NETWORK_POLICY_EVIDENCE_REF=
KUBERNETES_ADMIN_CLUSTER_TERMINAL_ENABLED=false
KUBERNETES_ADMIN_CLUSTER_TERMINAL_RECORDING_ENABLED=false
KUBERNETES_ADMIN_NODE_DEBUG_ENABLED=false
KUBERNETES_ADMIN_NODE_DEBUG_RECORDING_ENABLED=false
KUBERNETES_ADMIN_RESTRICTED_CREDENTIAL_EVIDENCE_REF=
KUBERNETES_ADMIN_INTERACTIVE_LIVE_SMOKE_EVIDENCE_REF=
KUBERNETES_ADMIN_INTERACTIVE_LIVE_SMOKE_REQUIRED=false
KUBERNETES_ADMIN_INTERACTIVE_METADATA_RETENTION_DAYS=365
KUBERNETES_ADMIN_INTERACTIVE_TRANSCRIPT_RETENTION_DAYS=30
KUBERNETES_ADMIN_TRANSCRIPT_EVENT_MAX_CHARS=2000
KUBERNETES_ADMIN_TRANSCRIPT_EVENT_MAX_COUNT=2000

# -----------------------------------------------------------------------------
# High-volume history retention (background history-pruner, never HTTP)
# -----------------------------------------------------------------------------
HISTORY_PRUNE_INTERVAL_SECONDS=86400
HISTORY_PRUNE_BATCH_SIZE=1000
HISTORY_RETENTION_PIPELINE_RUN_DAYS=90
HISTORY_RETENTION_PIPELINE_RUN_MAX_ROWS=100000
HISTORY_RETENTION_AGENT_RUN_DAYS=90
HISTORY_RETENTION_AGENT_RUN_MAX_ROWS=100000
HISTORY_RETENTION_SERVER_COMMAND_HISTORY_DAYS=90
HISTORY_RETENTION_SERVER_COMMAND_HISTORY_MAX_ROWS=500000
HISTORY_RETENTION_COMMAND_SNAPSHOT_DAYS=30
HISTORY_RETENTION_COMMAND_SNAPSHOT_MAX_ROWS=50000
COMMAND_SNAPSHOT_MAX_CONTENT_BYTES=1048576
HISTORY_RETENTION_SERVER_HEALTH_CHECK_DAYS=7
HISTORY_RETENTION_SERVER_HEALTH_CHECK_MAX_ROWS=1000000
HISTORY_RETENTION_RESOLVED_SERVER_ALERT_DAYS=30
HISTORY_RETENTION_RESOLVED_SERVER_ALERT_MAX_ROWS=500000
HISTORY_RETENTION_CHAT_ARTIFACT_DAYS=90
HISTORY_RETENTION_CHAT_ARTIFACT_MAX_ROWS=100000
HISTORY_RETENTION_USER_ACTIVITY_LOG_MAX_ROWS=500000
HISTORY_RETENTION_LLM_USAGE_LOG_MAX_ROWS=500000

# -----------------------------------------------------------------------------
# Plugin extension trust boundaries
# -----------------------------------------------------------------------------
PLUGIN_MARKETPLACE_ALLOW_SANDBOXED_CODE_PACKAGES=false
PLUGIN_MARKETPLACE_BACKEND_SANDBOX_ENABLED=false
# Never use local_subprocess in production: it has full application filesystem,
# database, secret, and network privileges. Use disabled or an isolated external worker.
PLUGIN_MARKETPLACE_BACKEND_SANDBOX_PROVIDER=external_worker
PLUGIN_BACKEND_RUNNER_IMAGE=
PLUGIN_BACKEND_DOCKER_EGRESS_NETWORK=
PLUGIN_BACKEND_DOCKER_CPUS=0.5
PLUGIN_BACKEND_DOCKER_MEMORY=128m
PLUGIN_BACKEND_DOCKER_PIDS_LIMIT=32
WEBTERM_PLUGIN_BACKEND_DOCKER_PROXY_IMAGE=webterm-plugin-backend-docker-proxy:latest
PLUGIN_MARKETPLACE_EXTERNAL_BACKEND_SANDBOX_ENDPOINT=https://sandbox.example.com/plugin-marketplace/execute
PLUGIN_MARKETPLACE_EXTERNAL_BACKEND_SANDBOX_AUTH_TOKEN=
PLUGIN_MARKETPLACE_BACKEND_SANDBOX_TIMEOUT_SECONDS=10
PLUGIN_MARKETPLACE_BACKEND_SANDBOX_MAX_OUTPUT_BYTES=262144
PLUGIN_MARKETPLACE_FRONTEND_SANDBOX_ENABLED=false
PLUGIN_MARKETPLACE_ALLOW_DYNAMIC_FRONTEND_BUNDLES=false
PLUGIN_MARKETPLACE_FRONTEND_BUNDLE_DISTRIBUTION_PROVIDER=external_artifact_host
PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_FRONTEND_BUNDLE_HOST=true
PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_ENDPOINT=https://bundles.example.com/plugin-marketplace/readiness
PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_AUTH_TOKEN=
PLUGIN_MARKETPLACE_EXTERNAL_FRONTEND_BUNDLE_TIMEOUT_SECONDS=10
PLUGIN_MARKETPLACE_FRONTEND_BUNDLE_ALLOWED_HOSTS=cdn.example.com
PLUGIN_MARKETPLACE_COMPATIBILITY_JOB_ISOLATION_MODE=subprocess_no_code
PLUGIN_MARKETPLACE_COMPATIBILITY_JOB_TIMEOUT_SECONDS=20
# Explicit ecosystem:name entries only. Packages with undeclared dependencies are blocked.
PLUGIN_MARKETPLACE_SANDBOX_DEPENDENCY_ALLOWLIST=
# Optional hard gate: require recent passed attestations before catalog compatibility or enable.
PLUGIN_MARKETPLACE_REQUIRED_ATTESTATION_KINDS=
PLUGIN_MARKETPLACE_ATTESTATION_MAX_AGE_DAYS=0
PLUGIN_MARKETPLACE_ATTESTATION_RETENTION_LIMIT=20
PLUGIN_MARKETPLACE_EGRESS_DENIED_HOSTS=metadata.google.internal,169.254.169.254
PLUGIN_MARKETPLACE_REMOTE_PACKAGE_ALLOWED_HOSTS=packages.example.com
# Exact HTTPS hosts only. Empty disables remote catalog sync (fail-closed).
PLUGIN_MARKETPLACE_CATALOG_SOURCE_ALLOWED_HOSTS=catalog.example.com

# Allowlisted GitLab hosts for one-time Ansible project imports.
PLAYBOOK_GITLAB_ALLOWED_HOSTS=gitlab.com
PLAYBOOK_GITLAB_TIMEOUT_SECONDS=15
PLUGIN_MARKETPLACE_SIGNING_PROVIDER=external_kms
PLUGIN_MARKETPLACE_SIGNING_KEYS={}
PLUGIN_MARKETPLACE_DEFAULT_SIGNING_KEY_ID=replace-with-kms-key-alias
PLUGIN_MARKETPLACE_REQUIRE_CONFIGURED_SIGNING_KEYS=true
PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_SIGNING_PROVIDER=true
PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_ENDPOINT=https://kms.example.com/plugin-marketplace/sign
PLUGIN_MARKETPLACE_EXTERNAL_VERIFY_ENDPOINT=https://kms.example.com/plugin-marketplace/verify
PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_AUTH_TOKEN=
PLUGIN_MARKETPLACE_EXTERNAL_SIGNING_TIMEOUT_SECONDS=5
PLUGIN_MARKETPLACE_SECURITY_SCAN_PROVIDER=external
PLUGIN_MARKETPLACE_REQUIRE_EXTERNAL_SECURITY_SCANNER=true
PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_ENDPOINT=https://scanner.example.com/plugin-marketplace/scan
PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_AUTH_TOKEN=
PLUGIN_MARKETPLACE_EXTERNAL_SECURITY_SCAN_TIMEOUT_SECONDS=20
PLUGIN_MARKETPLACE_SECURITY_SCAN_BLOCK_SEVERITIES=critical,high
PLUGIN_MARKETPLACE_SECURITY_SCAN_PASS_STATUSES=clean,ok,pass,passed,success
PLUGIN_MARKETPLACE_PACKAGE_RETENTION_DIR=
PLUGIN_MARKETPLACE_RETAINED_PACKAGE_MAX_AGE_DAYS=0

# -----------------------------------------------------------------------------
# Corporate proxies, only if needed
# -----------------------------------------------------------------------------
http_proxy=
https_proxy=
ftp_proxy=
no_proxy=localhost,127.0.0.1,::1,postgres,redis,backend,frontend,nginx,mcp-runner
HTTP_PROXY=
HTTPS_PROXY=
FTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,backend,frontend,nginx,mcp-runner
